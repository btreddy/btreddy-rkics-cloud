# ---- Supabase (Project Settings -> Database -> Connection string -> "Transaction" pooler) ----
DATABASE_URL=postgresql://postgres.xxxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TELEGRAM_DIGEST_CHAT_IDS=111111111,222222222

# ---- App settings ----
DEFAULT_GEOFENCE_RADIUS_M=300

# ---- Dashboard login ----
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me

# ---- Transcription (only needed on whichever machine runs transcribe.js) ----
WHISPER_MODEL=base.en
